{
  "color": {
    "bg": "#0b0f1a",
    "terrain": "#1e2a38",
    "water": "#006994",
    "uiPrimary": "#ffd166",
    "uiAccent": "#ef476f",
    "text": "#e0e0e0",
    "textMuted": "#8a8a8a"
  },
  "spacing": { "xs":4, "sm":8, "md":16, "lg":24, "xl":32 },
  "radius": { "sm":4, "md":8, "lg":16 },
  "typography": {
    "display": { "fontFamily":"'Orbitron',sans-serif", "size":28, "weight":700 },
    "body":    { "fontFamily":"'Inter',sans-serif", "size":14, "weight":400 },
    "label":   { "fontFamily":"'Inter',sans-serif", "size":12, "weight":600 }
  },
  "shadow": { "elev1":"0 2px 4px rgba(0,0,0,.4)", "elev2":"0 6px 12px rgba(0,0,0,.5)" },
  "transition": { "fast":"120ms ease-out", "mid":"250ms ease" }
}